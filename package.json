{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "offline:build": "pnpm --filter @workspace/crowdguard-sentinel run build",
    "offline:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-offline.ps1",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
