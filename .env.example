# Vercel build variables (replace with the actual Render service URL)
VITE_API_BASE_URL=https://crowdguard-sentinel.onrender.com/api
VITE_WS_URL=wss://crowdguard-sentinel.onrender.com/ws/live

# Render runtime variables.
# Standard *.vercel.app deployments are allowed by the regex in render.yaml.
CROWDGUARD_CORS_ORIGINS=https://your-crowdguard-project.vercel.app
CROWDGUARD_DEVICE_ID=crowdguard-sentinel-01
CROWDGUARD_DEVICE_TRANSPORT=CLOUD_POLL
CROWDGUARD_DEVICE_API_KEY=replace-with-a-long-random-secret
CROWDGUARD_DEVICE_STALE_SECONDS=20
